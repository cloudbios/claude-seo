#!/usr/bin/env bash
# Resolve a base Python without inheriting the legacy Claude SEO interpreter.
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
runtime="${script_dir}/codex_runtime.py"
check_python() {
    "$1" -I -B -c 'import sys; raise SystemExit(0 if (3,11) <= sys.version_info[:2] <= (3,14) else 1)' >/dev/null 2>&1
}
if [[ -n "${CODEX_SEO_PYTHON:-}" ]]; then
    if ! check_python "${CODEX_SEO_PYTHON}"; then
        echo 'CODEX_SEO_PYTHON must name a Python 3.11–3.14 executable.' >&2
        exit 2
    fi
    exec "${CODEX_SEO_PYTHON}" -I -B "${runtime}" "$@"
fi
for candidate in python3 python3.14 python3.13 python3.12 python3.11; do
    if command -v "${candidate}" >/dev/null 2>&1 && check_python "${candidate}"; then
        exec "${candidate}" -I -B "${runtime}" "$@"
    fi
done
echo 'Codex SEO requires Python 3.11–3.14. Install Python or set CODEX_SEO_PYTHON.' >&2
exit 2
